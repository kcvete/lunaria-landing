---
import { SITE_NAME, CONTACT_EMAIL, SOCIAL, LEGAL } from '../config';
import { routes, type Lang, type Dict, type RouteKey } from '../i18n';
import LogoMark from './LogoMark.astro';
import LangSwitch from './LangSwitch.astro';
import { withBase } from '../lib/url';
import { orTodo } from '../lib/todo';
interface Props {
  lang: Lang;
  t: Dict;
  route?: RouteKey;
}
const { lang, t, route = 'home' } = Astro.props;
const year = new Date().getFullYear();
const socials = Object.entries(SOCIAL).filter(([, href]) => href);
const L = t.footer.imprintLabels;
// Company details required by ZEPT Art. 5. Missing values show as [TODO].
const imprint = [
  { label: L.company, value: orTodo(LEGAL.companyName) },
  { label: L.address, value: orTodo(LEGAL.address) },
  { label: L.registrationNo, value: orTodo(LEGAL.registrationNo) },
  { label: L.taxNo, value: orTodo(LEGAL.taxNo) },
];
---

<footer class="site-footer">
  <div class="container inner">
    <div>
      <a class="brand" href={withBase(routes.home[lang])} aria-label={t.a11y.home}>
        <LogoMark size={20} />
        <span>{SITE_NAME}</span>
      </a>
      <p class="tagline">{t.footer.tagline}</p>
    </div>
    <div class="meta">
      <a class="plain" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      {
        socials.map(([name, href]) => (
          <a class="plain" href={href} target="_blank" rel="noopener">
            {name}
          </a>
        ))
      }
      <a class="plain" href={withBase(routes.privacy[lang])}>{t.footer.privacy}</a>
      <LangSwitch lang={lang} label={t.footer.language} route={route} />
    </div>
  </div>
  <div class="container">
    <section class="imprint" aria-label={t.footer.imprint}>
      <dl>
        {
          imprint.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
        <div>
          <dt>{L.email}</dt>
          <dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd>
        </div>
      </dl>
    </section>
    <p class="legal">© {year} {SITE_NAME}. {t.footer.rights} {t.footer.noCookies}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 3.5rem 2rem;
    border-top: 1px solid var(--rule-soft);
  }
  .inner {
    display: grid;
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .tagline {
    margin-top: 0.6rem;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }
  .plain {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .imprint {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-soft);
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.75rem 2rem;
    font-size: var(--step--1);
  }
  dl div {
    display: grid;
    gap: 0.1rem;
  }
  dt {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--muted);
  }
  dd {
    margin: 0;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .legal {
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (min-width: 40rem) {
    dl {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    dl {
      grid-template-columns: repeat(5, auto);
      justify-content: start;
    }
  }
  @media (min-width: 48rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
