---
import type { Dict, Lang } from '../i18n';
import CodeMoon from './CodeMoon.astro';
import Cta from './Cta.astro';
import { fill } from '../lib/fill';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const h = t.hero;
// The live demo named in the proof line under the CTA.
const demo = projects.find((p) => p.id === 'product-trimmer')?.links.find((l) => l.kind === 'demo');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <h1 id="hero-title">{h.title}</h1>
      <p class="sub rise" style="--d:100ms">{h.sub}</p>
      <div class="ctas rise" style="--d:260ms">
        <Cta lang={lang} location="hero" />
        <a class="link" href="#work">{h.ctaSecondary}</a>
      </div>
      <p class="trust rise" style="--d:320ms">{fill(h.trust)}</p>
      {
        demo && (
          <p class="proof rise" style="--d:360ms">
            {h.proof.lead}{' '}
            <a href={demo.href} target="_blank" rel="noopener">
              {h.proof.linkText}
              <span class="visually-hidden"> ({t.a11y.externalLink})</span>
            </a>{' '}
            {h.proof.rest}
          </p>
        )
      }
      <ul class="offer rise" style="--d:400ms" aria-label={h.servicesLabel}>
        {
          h.services.map((s) => (
            <li>
              <a href="#services">
                <span class="name">{s.name}</span>
                <span class="detail">{s.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="sky">
      <CodeMoon cols={84} lit={0.8} flips={14} class="hero-moon" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 0.5rem + 3.5vw, 4rem) var(--space-section);
  }
  .grid {
    display: grid;
    gap: 3rem;
  }
  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3.1vw, 4rem);
    letter-spacing: -0.036em;
    line-height: 1.02;
    max-width: 18ch;
    animation: settle 0.9s var(--ease) both;
  }
  .sub {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-2);
  }
  .offer {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 36rem;
    border-top: 1px solid var(--rule);
  }
  .offer a {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .detail {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .offer a:hover .name {
    color: var(--moon);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.5rem;
  }
  .trust {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .proof {
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .proof a {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--text);
    text-decoration-color: var(--moon);
  }
  .proof a:hover {
    color: var(--moon);
  }
  .sky {
    width: min(100%, 26rem);
    justify-self: center;
  }
  .rise {
    animation: rise 0.8s var(--ease) var(--d, 0ms) both;
  }
  .sky :global(.hero-moon) {
    animation: moonrise 1.8s var(--ease) 0.15s both;
  }
  @keyframes settle {
    from {
      transform: translateY(12px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes moonrise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (min-width: 40rem) {
    .offer a {
      grid-template-columns: 13rem 1fr;
      gap: 1.25rem;
      align-items: baseline;
    }
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 3rem;
    }
    .sky {
      width: 100%;
      max-width: 32rem;
      justify-self: end;
    }
  }
</style>
