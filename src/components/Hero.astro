---
import { BOOKING_HREF, bookingIsExternal } from '../config';
import type { Dict } from '../i18n';
import CodeMoon from './CodeMoon.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const h = t.hero;
const ext = bookingIsExternal ? { target: '_blank', rel: 'noopener' } : {};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <h1 id="hero-title">{h.title}</h1>
      <p class="sub rise" style="--d:100ms">{h.sub}</p>
      <ul class="offer rise" style="--d:180ms" aria-label={h.servicesLabel}>
        {
          h.services.map((s) => (
            <li>
              <a href="#services">
                <span class="name">{s.name}</span>
                <span class="detail">{s.detail}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="ctas rise" style="--d:260ms">
        <a class="btn" href={BOOKING_HREF} {...ext}>{h.ctaPrimary}</a>
        <a class="link" href="#contact">{h.ctaSecondary}</a>
      </div>
      <p class="trust rise" style="--d:320ms">{h.trust}</p>
    </div>
    <div class="sky">
      <CodeMoon cols={84} lit={0.8} flips={14} class="hero-moon" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.25rem, 1rem + 4vw, 5rem) var(--space-section);
  }
  .grid {
    display: grid;
    gap: 3rem;
  }
  h1 {
    font-size: clamp(2.3rem, 1.45rem + 3.6vw, 4.6rem);
    letter-spacing: -0.038em;
    line-height: 1;
    max-width: 15ch;
    animation: settle 0.9s var(--ease) both;
  }
  .sub {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-2);
  }
  .offer {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    max-width: 36rem;
    border-top: 1px solid var(--rule);
  }
  .offer a {
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .detail {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .offer a:hover .name {
    color: var(--moon);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
  }
  .trust {
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .sky {
    width: min(100%, 26rem);
    justify-self: center;
  }
  .rise {
    animation: rise 0.8s var(--ease) var(--d, 0ms) both;
  }
  .sky :global(.hero-moon) {
    animation: moonrise 1.8s var(--ease) 0.15s both;
  }
  @keyframes settle {
    from {
      transform: translateY(12px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes moonrise {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (min-width: 40rem) {
    .offer a {
      grid-template-columns: 13rem 1fr;
      gap: 1.25rem;
      align-items: baseline;
    }
  }
  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 7fr 5fr;
      align-items: center;
      gap: 3rem;
    }
    .sky {
      width: 100%;
      max-width: 32rem;
      justify-self: end;
    }
  }
</style>
