---
import type { Dict } from '../i18n';
import CodeMoon from './CodeMoon.astro';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const p = t.process;
// new moon → waxing crescent → first quarter → full moon
const phases = [0, 0.22, 0.5, 1];
---

<section id="process" class="process" aria-labelledby="process-title">
  <div class="container">
    <div class="head">
      <h2 id="process-title">{p.title}</h2>
      <p class="lede">{p.intro}</p>
    </div>
    <ol class="track">
      {
        p.steps.map((s, i) => (
          <li class="step">
            <CodeMoon cols={20} lit={phases[i] ?? 1} seed={11 + i} class="phase" />
            <h3>{s.name}</h3>
            <p class="when">{s.when}</p>
            <p class="text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: var(--space-section);
  }
  .head {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    position: relative;
  }
  .step {
    --m: 72px;
    position: relative;
    display: grid;
    grid-template-columns: var(--m) 1fr;
    column-gap: 1.5rem;
    padding-bottom: 2.75rem;
  }
  .step > :not(:global(.phase)) {
    grid-column: 2;
  }
  .step :global(.phase) {
    grid-row: 1 / span 3;
    width: var(--m);
    position: relative;
    z-index: 1;
  }
  /* the orbit line joining the phases */
  .step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(var(--m) / 2 - 0.5px);
    top: calc(var(--m) + 10px);
    bottom: 8px;
    width: 1px;
    background: var(--rule);
  }
  h3 {
    padding-top: 0.6rem;
    align-self: end;
  }
  .when {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--moon);
  }
  .text {
    margin-top: 0.75rem;
    color: var(--text-2);
    max-width: 30ch;
  }

  @media (min-width: 58rem) {
    .track {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: auto auto auto 1fr;
      column-gap: 2.5rem;
    }
    .step {
      --m: 104px;
      grid-row: span 4;
      grid-template-columns: 1fr;
      grid-template-rows: subgrid;
      padding-bottom: 0;
    }
    .step > :not(:global(.phase)) {
      grid-column: 1;
    }
    .step :global(.phase) {
      grid-row: auto;
      margin-bottom: 1.5rem;
    }
    .step:not(:last-child)::before {
      left: calc(var(--m) + 16px);
      right: -1.75rem;
      top: calc(var(--m) / 2);
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }
  .step :global(.phase .l0) {
    color: oklch(0.88 0.03 250 / 0.3);
  }
  .step :global(.phase .l1) {
    color: oklch(0.9 0.03 88 / 0.38);
  }
</style>
