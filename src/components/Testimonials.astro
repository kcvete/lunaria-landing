---
/** Client quotes. Renders nothing until src/data/testimonials.ts has entries. */
import type { Dict, Lang } from '../i18n';
import { testimonials } from '../data/testimonials';
interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
---

{
  testimonials.length > 0 && (
    <section class="testimonials" aria-labelledby="testimonials-title">
      <div class="container">
        <h2 id="testimonials-title">{t.testimonials.title}</h2>
        <ul>
          {testimonials.map((q) => (
            <li>
              <figure>
                <blockquote>
                  <p>{q.quote[lang]}</p>
                </blockquote>
                <figcaption>
                  {q.href ? (
                    <a href={q.href} target="_blank" rel="noopener">
                      {q.name}
                    </a>
                  ) : (
                    q.name
                  )}
                  , {q.role[lang]}, {q.company}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .testimonials {
    padding-block: 0 var(--space-section);
  }
  ul {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }
  figure {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--moon);
  }
  blockquote {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.55;
  }
  figcaption {
    margin-top: 0.9rem;
    font-family: var(--ff-display);
    font-weight: var(--w-medium, 500);
    color: var(--muted);
  }
  @media (min-width: 54rem) {
    ul {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
