---
import type { Dict } from '../i18n';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const a = t.ai;
---

<section id="ai" class="ai" aria-labelledby="ai-title">
  <div class="container">
    <h2 id="ai-title">{a.title}</h2>
    <p class="lede">{a.intro}</p>
    <ul class="points">
      {
        a.points.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ai {
    padding-block: var(--space-section);
    background: var(--night-1);
    border-block: 1px solid var(--rule-soft);
  }
  h2 {
    font-size: var(--step-4);
    letter-spacing: calc(var(--track, 1) * -0.04em);
    line-height: 0.98;
    max-width: 16ch;
  }
  .lede {
    margin-top: 1.5rem;
  }
  .points {
    list-style: none;
    margin: clamp(3rem, 2rem + 3vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 2.25rem;
  }
  .points li {
    display: grid;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--moon);
  }
  h3 {
    font-size: var(--step-1);
    letter-spacing: calc(var(--track, 1) * -0.01em);
  }
  .points p {
    color: var(--text-2);
  }
  @media (min-width: 54rem) {
    .points {
      grid-template-columns: 1.15fr 1fr 1fr;
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
  }
</style>
