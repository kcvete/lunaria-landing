---
import type { Dict } from '../i18n';
import { team } from '../data/team';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const tm = t.team;
const linkOrder = ['github', 'linkedin', 'site'] as const;
---

<section id="team" class="team" aria-labelledby="team-title">
  <div class="container">
    <h2 id="team-title">{tm.title}</h2>
    <p class="lede">{tm.intro}</p>
    <ul class="duo">
      {
        team.map((m) => {
          const copy = tm.members[m.id];
          const links = linkOrder.filter((k) => m.links[k]).map((k) => ({ kind: k, href: m.links[k] as string }));
          return (
            <li class="person">
              {m.photo ? (
                <img class="portrait" src={m.photo} alt={`${tm.photoAlt} ${m.name}`} width="112" height="112" loading="lazy" decoding="async" />
              ) : (
                <span class="portrait initials" aria-hidden="true">
                  {m.name.split(' ').map((n) => n[0]).join('')}
                </span>
              )}
              <div>
                <h3>{m.name}</h3>
                <p class="role">{copy.role}</p>
                <p class="bio">{copy.bio}</p>
                <p class="links">
                  {links.map((l) => (
                    <a class="link" href={l.href} target="_blank" rel="noopener me">
                      {tm.linkLabels[l.kind]}
                      <span class="visually-hidden"> ({t.a11y.externalLink})</span>
                    </a>
                  ))}
                </p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .team {
    padding-block: var(--space-section);
  }
  h2 {
    max-width: 18ch;
  }
  .lede {
    margin-top: 1.25rem;
  }
  .duo {
    list-style: none;
    margin: clamp(3rem, 2rem + 3vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }
  .person {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .portrait {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(0.35) contrast(1.05);
    background: var(--night-2);
  }
  .initials {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--moon);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  h3 {
    font-size: var(--step-2);
  }
  .role {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--moon);
  }
  .bio {
    margin-top: 1rem;
    color: var(--text-2);
    max-width: 34rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.1rem;
  }
  .links a {
    display: inline-block;
    padding-block: 0.3rem;
  }
  @media (min-width: 40rem) {
    .person {
      grid-template-columns: 7rem 1fr;
      gap: 1.75rem;
    }
    .portrait {
      width: 7rem;
      height: 7rem;
      font-size: 2.1rem;
    }
  }
  @media (min-width: 62rem) {
    .duo {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }
    .person + .person {
      padding-left: 3rem;
      border-left: 1px solid var(--rule);
    }
    .person:first-child {
      padding-right: 3rem;
    }
  }
</style>
