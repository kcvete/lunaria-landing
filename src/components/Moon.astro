---
/**
 * A moon at a given phase, drawn over the shared #moon-disc symbol.
 * `lit` is the waxing phase from 0 (new) through 0.5 (first quarter) to 1 (full).
 */
interface Props {
  lit: number;
  size?: number | string;
  class?: string;
  /** Show a faint outline so a new moon stays visible. */
  ring?: boolean;
}
const { lit, size = 48, class: className, ring = false } = Astro.props;
const c = 50;
const r = 48.5;
const t = Math.min(1, Math.max(0, lit));
const rx = Math.abs(1 - 2 * t) * r;
const sweep = t < 0.5 ? 0 : 1;
// Shadow = the unlit part: left half-disc, closed by the terminator ellipse.
const shadow =
  t >= 0.999 ? '' : `M${c},${c - r} A${r},${r} 0 0 0 ${c},${c + r} A${rx.toFixed(2)},${r} 0 0 ${sweep} ${c},${c - r} Z`;
const dim = typeof size === 'number' ? `${size}px` : size;
---

<svg class:list={['moon', className]} viewBox="0 0 100 100" style={`width:${dim};height:${dim}`} aria-hidden="true" focusable="false">
  <use href="#moon-disc"></use>
  {
    shadow && (
      <g clip-path="url(#moon-clip)">
        <path d={shadow} fill="#101729" fill-opacity="0.9" filter="url(#moon-terminator)" />
      </g>
    )
  }
  {ring && <circle cx="50" cy="50" r="48.5" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1" />}
</svg>
