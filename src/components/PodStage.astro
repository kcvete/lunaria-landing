---
/**
 * Growth stages of the honesty plant, used as Process step markers:
 * 0 bud → 1 flower → 2 green pod → 3 dried silver pod.
 */
interface Props {
  stage: 0 | 1 | 2 | 3;
  class?: string;
}
const { stage, class: className } = Astro.props;
const petal = 'M0,0 C-7,-3 -7.5,-13 0,-14 C7.5,-13 7,-3 0,0Z';
---

<svg class:list={['stage', className]} viewBox="0 0 80 80" aria-hidden="true" focusable="false">
  <path d="M40 78 C40 66 40 58 40 50" class="stem" />
  {
    stage === 0 && (
      <g>
        <path d="M40 52 C33 46 34 34 40 28 C46 34 47 46 40 52Z" class="bud" />
        <path d="M40 52 C37 46 37.5 38 40 33" class="bud-line" />
      </g>
    )
  }
  {
    stage === 1 && (
      <g transform="translate(40 38)">
        {[0, 90, 180, 270].map((a) => <path d={petal} transform={`rotate(${a + 12})`} class="petal" />)}
        <circle r="2.6" class="eye" />
      </g>
    )
  }
  {
    stage === 2 && (
      <g transform="translate(40 32) rotate(-14)">
        <ellipse rx="17" ry="16" class="pod-green" />
        <line x1="0" y1="-16" x2="0" y2="16" class="septum" />
        <ellipse cx="-3" cy="-6" rx="3" ry="2.5" class="seed-green" />
        <ellipse cx="3" cy="6" rx="3" ry="2.5" class="seed-green" />
      </g>
    )
  }
  {
    stage === 3 && (
      <g transform="translate(40 32) rotate(-14)">
        <ellipse rx="17" ry="16" class="pod-silver" />
        <line x1="0" y1="-16" x2="0" y2="16" class="septum" />
        <ellipse cx="-3" cy="-6" rx="3" ry="2.5" class="seed" />
        <ellipse cx="3" cy="6" rx="3" ry="2.5" class="seed" />
        <ellipse rx="17" ry="16" class="rim" />
      </g>
    )
  }
</svg>

<style>
  .stage {
    display: block;
    width: 100%;
    height: auto;
  }
  .stem,
  .bud-line {
    fill: none;
    stroke: oklch(0.62 0.02 245);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .bud {
    fill: oklch(0.55 0.05 150 / 0.55);
    stroke: oklch(0.72 0.05 150);
    stroke-width: 1.2;
  }
  .petal {
    fill: oklch(0.93 0.01 250);
    stroke: oklch(0.8 0.02 250);
    stroke-width: 0.6;
  }
  .eye {
    fill: var(--violet);
  }
  .pod-green {
    fill: oklch(0.6 0.06 150 / 0.35);
    stroke: oklch(0.74 0.06 150);
    stroke-width: 1.3;
  }
  .seed-green {
    fill: oklch(0.5 0.06 150 / 0.7);
  }
  .pod-silver {
    fill: oklch(0.9 0.012 245 / 0.18);
  }
  .rim {
    fill: none;
    stroke: var(--moon);
    stroke-width: 1.4;
  }
  .septum {
    stroke: oklch(0.85 0.015 245 / 0.4);
    stroke-width: 0.8;
  }
  .seed {
    fill: oklch(0.5 0.03 250 / 0.55);
    stroke: oklch(0.85 0.015 245 / 0.4);
    stroke-width: 0.6;
  }
</style>
