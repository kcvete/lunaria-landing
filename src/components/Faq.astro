---
import type { Dict } from '../i18n';
import { SHOW_PRICING } from '../config';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const f = t.faq;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="container split">
    <h2 id="faq-title">{f.title}</h2>
    <div class="list">
      {
        f.items.map((item, i) => (
          <details>
            <summary>
              <span class="q">{item.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <p>{item.a}</p>
            {/* Price guide inside the cost answer, hidden until SHOW_PRICING is true. */}
            {SHOW_PRICING && i === 0 && (
              <div class="pricing">
                <p>{f.pricing.lead}</p>
                <dl>
                  {f.pricing.items.map((row) => (
                    <div>
                      <dt>{row.label}</dt>
                      <dd>{row.from}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--space-section);
  }
  .split {
    display: grid;
    gap: 2.5rem;
  }
  h2 {
    max-width: 12ch;
  }
  .list {
    border-top: 1px solid var(--rule);
  }
  details {
    border-bottom: 1px solid var(--rule);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  summary:hover .q {
    color: var(--moon);
  }
  .icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 1.5px;
    background: var(--moon);
    transition: transform 0.25s var(--ease);
  }
  .icon::after {
    transform: rotate(90deg);
  }
  details[open] .icon::after {
    transform: rotate(0deg);
  }
  .pricing {
    padding: 0 2.5rem 1.6rem 0;
  }
  .pricing p {
    padding: 0 0 0.6rem;
  }
  .pricing dl {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  .pricing dl div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 30rem;
  }
  .pricing dt {
    color: var(--text-2);
  }
  .pricing dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--moon);
  }
  details p {
    padding: 0 2.5rem 1.6rem 0;
    color: var(--text-2);
    max-width: 60ch;
  }
  @media (min-width: 54rem) {
    .split {
      grid-template-columns: 4fr 8fr;
      gap: 4rem;
      align-items: start;
    }
    h2 {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }
</style>
