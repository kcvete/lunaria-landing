---
/** Wordmark mark: one honesty seed pod, an upright silver disc on a thin curved stalk. */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="mark">
  <path d="M8.6 23.4 C9 20.6 10.4 18.6 12.4 17.4" fill="none" stroke="var(--moon)" stroke-width="0.9" stroke-linecap="round" opacity="0.8"></path>
  <ellipse cx="13.6" cy="10.2" rx="6.4" ry="7.2" fill="var(--moon)" fill-opacity="0.16"></ellipse>
  <path d="M13.6 3 V17.4" stroke="var(--moon)" stroke-width="0.6" opacity="0.5"></path>
  <ellipse cx="13.2" cy="7.4" rx="1.05" ry="1.25" fill="var(--moon)" opacity="0.7"></ellipse>
  <ellipse cx="14" cy="10.3" rx="1.05" ry="1.25" fill="var(--moon)" opacity="0.7"></ellipse>
  <ellipse cx="13.2" cy="13.2" rx="1.05" ry="1.25" fill="var(--moon)" opacity="0.7"></ellipse>
  <ellipse cx="13.6" cy="10.2" rx="6.4" ry="7.2" fill="none" stroke="var(--moon)" stroke-width="1.3"></ellipse>
  <path d="M13.6 3 l0.5 -2" stroke="var(--moon)" stroke-width="0.9" stroke-linecap="round"></path>
</svg>
