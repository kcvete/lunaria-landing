---
import type { Dict, Lang } from '../i18n';
import { featuredProjects } from '../data/projects';
import CodeMoon from './CodeMoon.astro';
import Cta from './Cta.astro';
import { Picture } from 'astro:assets';

interface Props {
  lang: Lang;
  t: Dict;
}
const { lang, t } = Astro.props;
const w = t.work;
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="container">
    <div class="head">
      <h2 id="work-title">{w.title}</h2>
      <p class="lede">{w.intro}</p>
    </div>

    <ul class="mosaic">
      {
        featuredProjects.map((p, i) => (
          <li class="project">
            <div class="visual">
              <p class="pill">{w.status[p.status]}</p>
              {p.links[0] && (
                <a class="visual-link" href={p.links[0].href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" />
              )}
              {p.image ? (
                <Picture
                  src={p.image}
                  formats={['avif', 'webp']}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 54rem) 55vw, 100vw"
                  alt={`${w.screenshotAlt} ${p.name}`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="placeholder" aria-hidden="true">
                  <span class="initial">{p.name}</span>
                  <CodeMoon cols={44} lit={p.placeholderPhase} seed={7 + i} class="ph-moon" />
                </div>
              )}
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <p class="summary">{p.summary[lang]}</p>
              {p.shows && (
                <p class="shows">
                  <span class="shows-label">{w.showsLabel}</span>
                  {p.shows[lang]}
                </p>
              )}
              <dl class="facts">
                <div>
                  <dt>{w.platformsLabel}</dt>
                  <dd>{p.platforms[lang].join(', ')}</dd>
                </div>
                <div>
                  <dt>{w.stackLabel}</dt>
                  <dd>{p.stack.join(', ')}</dd>
                </div>
              </dl>
              {p.links.length > 0 && (
                <p class="links">
                  {p.links.map((l) => (
                    <a class="link" href={l.href} target="_blank" rel="noopener">
                      {w.linkLabels[l.kind]}
                      <span class="visually-hidden"> ({t.a11y.externalLink})</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="next">
      <div>
        <h3>{w.more.title}</h3>
        <p>{w.more.text}</p>
      </div>
      <Cta lang={lang} location="work" />
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-section);
  }
  .head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    max-width: 44rem;
  }
  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 4rem);
  }
  .project {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .visual {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: var(--night-1);
    outline: 1px solid var(--rule-soft);
    outline-offset: -1px;
  }
  .visual :global(picture) {
    display: block;
    height: 100%;
  }
  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .visual-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .visual:has(.visual-link:hover) :global(img) {
    transform: scale(1.025);
  }
  .pill {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 3;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: oklch(0.165 0.03 var(--hue) / 0.88);
    outline: 1px solid var(--rule);
    font-family: var(--ff-label);
    font-weight: var(--w-medium, 500);
    font-size: calc(0.875rem * var(--label-scale, 1));
    color: var(--text);
    pointer-events: none;
  }
  .placeholder {
    position: relative;
    background: var(--stars) 30% 40% / 380px 380px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: clamp(1rem, 0.6rem + 2vw, 2rem);
  }
  .initial {
    font-family: var(--ff-display);
    font-weight: var(--w-strong, 600);
    font-size: clamp(2.6rem, 1.5rem + 5vw, 5rem);
    line-height: 0.85;
    letter-spacing: calc(var(--track, 1) * -0.05em);
    color: var(--rule);
  }
  .placeholder :global(.ph-moon) {
    position: absolute;
    top: 12%;
    right: 8%;
    width: 36%;
  }
  .body {
    display: grid;
    gap: 0.75rem;
    max-width: 38rem;
  }
  h3 {
    font-size: var(--step-2);
  }
  .summary {
    color: var(--text-2);
  }
  .shows {
    margin-top: 0.25rem;
    padding-left: 1rem;
    border-left: 2px solid var(--moon);
    color: var(--text);
  }
  .shows-label {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--ff-label);
    font-weight: var(--w-medium, 500);
    font-size: calc(1rem * var(--label-scale, 1));
    color: var(--moon);
  }
  .facts {
    display: grid;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
    font-size: 1rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 1rem;
  }
  dt {
    font-family: var(--ff-label);
    font-weight: var(--w-medium, 500);
    color: var(--muted);
  }
  dd {
    margin: 0;
    color: var(--text);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .links .link {
    padding-block: 0.6rem;
  }

  .next {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    margin-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .next h3 {
    font-size: var(--step-3);
    font-weight: var(--w-strong, 600);
    letter-spacing: calc(var(--track, 1) * -0.035em);
  }
  .next p {
    margin-top: 0.75rem;
    max-width: 34rem;
    color: var(--text-2);
  }

  @media (min-width: 54rem) {
    /* one product per row, image and text side by side, sides alternating */
    .mosaic {
      gap: clamp(4rem, 2rem + 4vw, 6.5rem);
    }
    .project {
      grid-template-columns: 7fr 5fr;
      column-gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: center;
    }
    .project:nth-child(even) {
      grid-template-columns: 5fr 7fr;
    }
    .project:nth-child(even) .visual {
      order: 2;
    }
    .next {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
