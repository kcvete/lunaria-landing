---
import '../styles/global.css';
import { SITE_NAME, SITE_URL, CONTACT_EMAIL, OG_IMAGE, PREVIEW_NOINDEX } from '../config';
import { withBase } from '../lib/url';
import { languages, defaultLang, useTranslations, type Lang } from '../i18n';
import { Font } from 'astro:assets';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(SITE_URL);
// Absolute URLs (canonical, hreflang, OG) include the base path.
const abs = (path: string) => new URL(withBase(path), site).href;
const canonical = abs(languages[lang].path);
const ogImage = abs(OG_IMAGE);
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: abs(languages[code].path),
}));
const otherOgLocales = (Object.keys(languages) as Lang[])
  .filter((code) => code !== lang)
  .map((code) => useTranslations(code).meta.ogLocale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: abs(''),
  email: CONTACT_EMAIL,
  description: t.meta.description,
  address: { '@type': 'PostalAddress', addressCountry: 'SI' },
  areaServed: 'EU',
};
---

<!doctype html>
<html lang={lang} style={`--stars:url(${withBase('stars.svg')})`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#0d1424" />
    <meta name="color-scheme" content="dark" />
    {PREVIEW_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={abs(languages[defaultLang].path)} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    {otherOgLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload={[{ subset: 'latin', weight: '600' }]} />
    <Font cssVariable="--font-text" preload={[{ subset: 'latin', weight: '400' }]} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <noscript>
      <style>
        .menu-toggle { display: none !important; }
        .site-header .panel { display: grid !important; position: static !important; }
        .site-header .bar { flex-wrap: wrap; }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
    <script is:inline>
      // Keep the current section when switching language (#work -> /sl/#work).
      document.querySelectorAll('[data-lang-link]').forEach((a) =>
        a.addEventListener('click', () => location.hash && (a.href = a.pathname + location.hash)),
      );
    </script>
  </body>
</html>
